# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# FVM Version Cache
.fvm/

# Internal working notes
.ignore/

# Claude Code instructions
CLAUDE.md

# Vendored plugins: their own build output (Rust target/ alone is hundreds of MB)
packages/*/.dart_tool/
packages/*/build/
packages/*/rust/target/
packages/*/cargokit/build_tool/.dart_tool/

# Secrets and release artifacts, wherever they land
.env
.env.*
*.p12
*.pem
*.apk
*.aab

# Release builds (scripts/release.sh)
/dist/
